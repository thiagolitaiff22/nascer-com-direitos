{
  "manifest_version": 3,
  "name": "Queda de Energia · Pauta do PROJUDI",
  "version": "1.0",
  "description": "Nascer com Direitos: busca a pauta de audiências no PROJUDI e entrega ao sistema.",
  "content_scripts": [
    {
      "matches": ["https://projudi.tjam.jus.br/projudi/*"],
      "js": ["projudi.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://SEU-USUARIO.github.io/nascer-com-direitos/*", "http://localhost:5173/*"],
      "js": ["bi.js"],
      "run_at": "document_start"
    }
  ]
}
